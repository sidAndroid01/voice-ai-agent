# --- LiveKit (WebRTC transport). Cloud: https://cloud.livekit.io  | self-host: livekit-server --dev
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Model providers. Only providers with a key are used; the rest of each chain is failover.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=

# --- Pipeline chains: "provider:model", primary first
# STT_CHAIN=deepgram:nova-3,openai:gpt-4o-mini-transcribe
# STT_CHAIN=deepgram:flux-general-en          # STT-integrated end-of-turn (set TURN_DETECTION=stt)
# LLM_CHAIN=anthropic:claude-haiku-4-5,openai:gpt-4.1-mini
# TTS_CHAIN=cartesia:sonic-3,elevenlabs:eleven_flash_v2_5,openai:gpt-4o-mini-tts
# AGENT_LANGUAGE=en                           # "multi" for code-switching (nova-3 multilingual)
# STT_KEYTERMS=Acme,Ava                       # boost brand/product names

# --- Turn taking & barge-in
# TURN_DETECTION=semantic                     # semantic | stt | vad
# ENDPOINTING_MODE=dynamic
# MIN_ENDPOINTING_DELAY=0.3
# MAX_ENDPOINTING_DELAY=2.5
# PREEMPTIVE_GENERATION=1
# PREEMPTIVE_TTS=1
# MIN_INTERRUPTION_DURATION=0.35
# FALSE_INTERRUPTION_TIMEOUT=1.5

# --- Call lifecycle
# USER_AWAY_TIMEOUT=8
# MAX_SILENCE_PROMPTS=2
# HOLD_TIMEOUT=60
# MAX_CALL_DURATION=1800
# TOOL_TIMEOUT=8
# TOOL_FILLER_DELAY=0.7

# --- Infra
# REDIS_URL=redis://localhost:6379/0          # enables per-turn checkpoints + failover resume
# NOISE_CANCELLATION=1                        # LiveKit Cloud enhanced noise cancellation (BVC)
# DATE_ORDER=DMY                              # how to read 05/09/2026
# AGENT_NAME=Ava
# COMPANY_NAME=Acme Store
